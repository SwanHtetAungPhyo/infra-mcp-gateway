# Copy to .env for local runs. Never commit .env.

# ---- MCP gateway (-mode=http / -mode=stdio) ----
# Required in http mode, at least 32 characters: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Networks nmap_scan may touch. Unset means nothing is scannable.
NMAP_ALLOWED_CIDRS=127.0.0.1/32
# Folders trivy fs/config may read (colon-separated). Default: $HOME. Never /.
TRIVY_ALLOWED_ROOTS=
# Optional: limit which tools this instance serves. Empty means all.
ENABLED_TOOLS=
# Scans running at once across all tools.
MAX_CONCURRENT_SCANS=2
# Optional: /readyz also checks this Trivy server.
TRIVY_SERVER=

# ---- Scheduled runner (-mode=runner) ----
TOOL_NAME=nmap
HUB_URL=
RESULT_URL=
CLAIM_TOKEN=
RUN_INTERVAL=1h
